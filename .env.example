# javagt-decrypt-tv — environment configuration
#
# Copy to .env (gitignored) and fill in your values. The downloader loads this
# via dotenv on startup. Never commit the real .env.
#
# The automated TVNZ email-code login is the only supported auth path — the
# TVNZ provider delegates to @javagt/tvnz-plus-api. Secrets shared with that
# SDK can be overridden here (the SDK has embedded public defaults, so these
# are only needed if you override them).

# TVNZ+ account used by the automated login. Used when no --email flag is
# passed: tvnz-decrypt <url> logs in as this account automatically.
TVNZ_EMAIL=tvnz@one.javagrant.ac.nz

# Widevine device file (private DRM key) used for decryption.
WIDEVINE_DEVICE_FILEPATH=./device.wvd

# Optional overrides forwarded to @javagt/tvnz-plus-api (values readable at
# http://www.tvnz.co.nz itself; present here so a single .env documents them).
# NOTE about TVNZ_API_PASSWORD: "pi" not "api" — the older "Tv9z@api2026$"
# fails with "Authentication Failed".
TVNZ_API_USER=qpapiuser
TVNZ_API_PASSWORD=Tv9z@pi2026$
TVNZ_CLIENT_ID=webclient-ui-app
TVNZ_CLIENT_SECRET=f99d00b8-5b20-4c27-983d-d2895f3e9fec

# Optional: reCAPTCHA token (auto provider also reads ~/.tvnz-captcha).
# TVNZ_CAPTCHA_TOKEN=<token>
# Optional: explicit session file for credentials (auto-detects otherwise).
# TVNZ_SESSION_FILE=./downloads/tvnz-session-automated.json

# ThreeNow provider (unchanged legacy login — not used for TVNZ).
THREENOW_USERNAME=_______
THREENOW_PASSWORD=_______